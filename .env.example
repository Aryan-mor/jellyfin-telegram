# Copy this file to .env and fill in the values. Never commit .env.

# You can skip this file. Run the program with no settings and it opens a setup page.

# --- Telegram (required) ---

# From https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The private channel that holds your media: a link to one of its messages, or its id.
TELEGRAM_CHANNEL_ID=

# Comma-separated bot tokens from @BotFather. Add as many as you like.
# Every bot must be an admin of the channel above.
TELEGRAM_BOT_TOKENS=

# Parallel downloads per bot.
TELEGRAM_BOT_CONCURRENCY=4

# --- Gateway ---

# The one port this program serves everything from: Jellyfin, streams and the setup page.
GATEWAY_LISTEN=0.0.0.0:8097

# Only needed with your own Jellyfin, for clients that connect to it directly. It is the base URL
# written into .strm files, so Jellyfin and those clients must all be able to reach it.
GATEWAY_PUBLIC_URL=

# Secret placed in stream URLs. Leave empty to generate one in DATA_DIR on first run.
GATEWAY_TOKEN=

# Blocks of 1 MiB fetched ahead of a sequential reader.
GATEWAY_READAHEAD_BLOCKS=8

# --- Storage ---

# Generated .strm tree. Point Jellyfin libraries at LIBRARY_DIR/Movies and LIBRARY_DIR/Shows.
LIBRARY_DIR=./library

# Database, bot sessions and block cache.
DATA_DIR=./data

# Disk limit for evictable video blocks. Pinned probe blocks do not count.
CACHE_MAX_GB=4

# --- Indexing ---

# Seconds between checks for new channel messages.
SYNC_INTERVAL_SECONDS=60

# --- Jellyfin ---

# Leave these empty and a private copy of Jellyfin is downloaded, set up and run for you.
# To use your own instead, give its URL as seen from here and a key from Dashboard -> API Keys.
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Set to false to run with no Jellyfin at all when JELLYFIN_URL is empty.
JELLYFIN_MANAGED=true

# Seerr asks for movies and shows. It is on by default whenever Jellyfin is configured,
# including a Jellyfin you already run, and opens at /seerr/ on the same port. It needs Docker.
# Set false to skip it.
SEERR_MANAGED=

# Fladder is a Jellyfin web client. It is on by default with Jellyfin, at /fladder/, and Seerr
# is filled in. It needs Docker. Set false to skip it.
FLADDER_MANAGED=

# --- Subtitles (need the Jellyfin settings above) ---

# Your language, as a code such as en, de, fr, fa or ja. Leave empty to turn subtitle handling
# off. Changing it checks every file again.
SUBTITLE_LANGUAGE=

# Fetch subtitles from sub-plus.ir for files with no track in your language. This sends the
# title or IMDb id of each such video to that third-party site. Set to false to stop it.
SUBTITLES_ONLINE=true

# Full path to ffprobe. Leave empty to look in PATH and the Jellyfin install folder.
FFPROBE_PATH=

# Embedded subtitles are extracted once per file in the background and kept in the channel, so
# Jellyfin never has to read a whole video for them. This reads each such file once at this speed
# and pauses while anything plays. Use 0 to turn it off.
SUBTITLE_EXTRACT_MB_PER_SEC=3

# Jellyfin's data folder as seen from this service, needed when Jellyfin runs in Docker or on
# another machine. Leave empty to ask Jellyfin, which works when both share the same disk.
JELLYFIN_DATA_DIR=

# --- Downloads (off until you turn them on in the panel) ---

# Seerr asks, Radarr or Sonarr grabs, qBittorrent downloads, a signed-in Telegram account posts
# the file to the channel, and the copy on disk is deleted after Jellyfin has probed it.
# Needs Docker. A file larger than the account can send is refused, not split.
DOWNLOADS_ENABLED=false

# Shared folder for qBittorrent, Radarr and Sonarr. Empty uses DATA_DIR/downloads.
DOWNLOADS_DIR=

# qBittorrent pauses when free space drops below this. It resumes when space comes back.
DOWNLOADS_MIN_FREE_GB=20

# Radarr and Sonarr search once when a title is added. This makes them look again for everything still
# missing, so a release that Bitmagnet learns of later is found. Minutes, 0 turns it off. Films that
# are not out yet are left alone.
DOWNLOADS_SEARCH_EVERY_MINUTES=60

# Bitmagnet stops crawling the DHT after its database reaches this size. Search keeps working.
BITMAGNET_DB_MAX_GB=40

# Pace for each signed-in account. These are cautious guesses, not a Telegram guarantee.
# 0 MB/s means no speed cap. Hours empty means all day, or a window such as 01-08.
UPLOAD_MB_PER_SEC=8
UPLOAD_REST_MINUTES=5
UPLOAD_LONG_REST_EVERY_GB=20
UPLOAD_LONG_REST_MINUTES=60
UPLOAD_DAILY_GB=50
UPLOAD_HOURS=
